# ==============================================================================
# GemControl web console (Vite / React)
# ==============================================================================

# --- Dependencies ------------------------------------------------------------
node_modules/
.npm
*.tgz

# --- Environment --------------------------------------------------------------
# .env.development / .env.production hold only public API URLs and ARE committed
# on purpose (Vite inlines them into the client bundle). Local overrides are not.
.env
.env.local
.env.*.local
!.env.example

# --- Build output ------------------------------------------------------------
dist/
dist-ssr/
build/
*.local

# --- Vite / tooling cache ------------------------------------------------------
.vite/
node_modules/.vite/
.eslintcache

# --- Tests / coverage --------------------------------------------------------
coverage/

# --- Logs ------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
