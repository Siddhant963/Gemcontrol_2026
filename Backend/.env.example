# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=5000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/ratnsetu

# JWT Secret (Change this in production!)
JWT_SECRET=your_jwt_secret_here

# Cloudinary Configuration
Cloudnary_API_KEY=your_cloudinary_api_key
Cloudnary_API_SECRET=your_cloudinary_api_secret
Cloudnary_CLOUD_NAME=your_cloudinary_cloud_name

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:3000

# Razorpay (subscription billing) -- test-mode keys from the Razorpay
# Dashboard; RAZORPAY_WEBHOOK_SECRET comes from the webhook's own config
# screen there (Settings > Webhooks), not the API Keys screen.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Apple In-App Purchase (iOS subscriptions only -- Android/Web keep using
# Razorpay above unchanged). See Backend/Utils/appleIap.js.
#
# Your app's bundle id -- must exactly match the iOS Xcode project
# (Mobile-gem/gemcontrol_app/ios). Defaults to com.ratnsetu.app if unset.
APPLE_BUNDLE_ID=com.ratnsetu.app
# Your app's numeric Apple ID (App Store Connect > App Information >
# General Information > Apple ID). REQUIRED once APPLE_IAP_ENVIRONMENT is
# "Production" -- the Apple library refuses to construct a Production
# verifier without it. Optional/omit for Sandbox-only testing.
APPLE_APP_APPLE_ID=
# "Production" (default) or "Sandbox". Either way, both
# fetchVerifiedTransaction and the notifications handler automatically
# retry against the other environment before failing, so Sandbox/TestFlight
# testers and real customers both work against one deployment -- this only
# picks which one is tried first for SIGNATURE verification.
APPLE_IAP_ENVIRONMENT=Production
# Separate from the above: whether a genuinely-verified SANDBOX transaction
# is allowed to activate a REAL subscription. Must be "false" (or unset) in
# production -- a Sandbox Apple ID is free to create, so without this gate
# anyone could "buy" a subscription for $0 and have it accepted. Set to
# "true" only on a staging/dev deployment where you want Sandbox purchases
# to actually activate entitlement for testing.
APPLE_IAP_ALLOW_SANDBOX=false
# App Store Server API credentials, from App Store Connect > Users and
# Access > Integrations > In-House Keys (or "App Store Connect API" keys
# scoped for App Store Server API). Generating a key there gives you the
# Key ID and Issuer ID, and downloads the .p8 private key file ONCE --
# store it securely, Apple will not let you download it again.
APPLE_IAP_KEY_ID=your_apple_key_id
APPLE_IAP_ISSUER_ID=your_apple_issuer_id
# Provide EITHER of these (not both) for the downloaded .p8 key contents:
#   - APPLE_IAP_PRIVATE_KEY: the PEM contents, with actual newlines
#     replaced by literal "\n" (common requirement for single-line env vars
#     in most hosting dashboards)
#   - APPLE_IAP_PRIVATE_KEY_PATH: an absolute path to the .p8 file on disk
#     (simpler for local dev / a server you control directly)
# NEVER commit the real key or paste its contents into logs.
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_PRIVATE_KEY_PATH=
